# Required. TARGET_URL may be the site origin or the dedicated probe URI.
TARGET_URL=https://timer.example.com
LOAD_TEST_KEY=replace-with-the-same-random-32-character-server-key

# Reproducible workload identity.
RUN_LABEL=baseline
RANDOM_SEED=20260815
SCENARIO=ramp
# Used only when SCENARIO=endpoint.
ENDPOINT=dashboard

# Optional. Defaults to the login page on the same origin. It is checked in a
# separate thread throughout the run to verify normal users can still connect.
# PUBLIC_CHECK_URL=https://timer.example.com/accounts/login/

# Conservative automatic ramp for a small VPS. The server-advertised cap is
# authoritative. A deliberate later run can use 1,5,10,20,50,100,200,500,1000.
RAMP_STEPS=1,5,10,20
STAGE_SECONDS=30
COOLDOWN_SECONDS=5
USER_COUNT=60
CONCURRENCY=16
TIMEOUT_SECONDS=8
SAMPLE_INTERVAL_SECONDS=1
DB_SAMPLE_INTERVAL_SECONDS=5

# Automatic stop/knee guards. No storage benchmark is ever performed.
MAX_ERROR_PERCENT=1
MAX_P99_MS=1000
MIN_AVAILABLE_MEMORY_MB=256
MAX_CPU_PERCENT=95
HIGH_CPU_SAMPLES=5
MAX_SWAP_GROWTH_MB=32
MAX_DB_WAITING=1
MAX_NETWORK_UTILIZATION_PERCENT=90
QUEUE_P99_JUMP_MS=40
MINIMUM_THROUGHPUT_GAIN_RATIO=0.5
HEADROOM_PERCENT=40

# 22:00 capacity model. Scenarios beyond provisioned isolated users are marked
# derived-only and are never falsely labeled as measured.
BURST_DAU_STEPS=100,500,1000,2000,5000,10000
BURST_WINDOWS_SECONDS=600,120,30
FINISH_FRACTION=0.60

CLEANUP_AFTER_RUN=true
REPORT_ROOT=load-test-results
