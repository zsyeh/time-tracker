[Unit]
Description=Retry pending Personal Learning OS GitHub note exports
Wants=network-online.target
After=network-online.target time-tracker-web.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/root/time-tracker
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/time-tracker/.venv/bin/python manage.py sync_github_notes --limit 20
Nice=10
PrivateTmp=true
NoNewPrivileges=true
