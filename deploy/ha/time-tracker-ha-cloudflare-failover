#!/usr/bin/env python3
import json
import pathlib
import urllib.request

TOKEN_FILE = pathlib.Path('/var/snap/docker/common/time-tracker-ha/secrets/cloudflare.ini')
STATE_DIR = pathlib.Path('/srv/time-tracker-ha/state')
NAMES = ('timer.ehzsy.site', 'drill.ehzsy.site', 'ei.ehzsy.site')
FAILOVER_IP = '47.95.10.128'

token = TOKEN_FILE.read_text().split('=', 1)[1].strip()
headers = {'Authorization': f'Bearer {token}', 'Content-Type': 'application/json'}

def api(method, path, payload=None):
    body = json.dumps(payload).encode() if payload is not None else None
    request = urllib.request.Request(
        f'https://api.cloudflare.com/client/v4{path}', data=body,
        headers=headers, method=method,
    )
    with urllib.request.urlopen(request, timeout=15) as response:
        result = json.load(response)
    if not result.get('success'):
        raise RuntimeError(result)
    return result['result']

zone = api('GET', '/zones?name=ehzsy.site&status=active')[0]
saved = []
for name in NAMES:
    records = api('GET', f"/zones/{zone['id']}/dns_records?type=A&name={name}")
    if len(records) != 1:
        raise RuntimeError(f'Expected exactly one A record for {name}, found {len(records)}')
    record = records[0]
    saved.append(record)
    api('PUT', f"/zones/{zone['id']}/dns_records/{record['id']}", {
        'type': 'A', 'name': name, 'content': FAILOVER_IP,
        'ttl': 1, 'proxied': True,
    })

STATE_DIR.mkdir(parents=True, exist_ok=True)
(STATE_DIR / 'dns-before-failover.json').write_text(json.dumps(saved, indent=2))
(STATE_DIR / 'dns-active.json').write_text(json.dumps({'content': FAILOVER_IP, 'names': NAMES}))
