DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Docker 对外端口；本地直接运行 Django 时可忽略。
TRACKER_PORT=8000
# Username used by the private MCP compatibility service.
TRACKER_OWNER_USERNAME=
SESSION_REMEMBER_DAYS=30
SECURE_HSTS_SECONDS=3600
CSRF_TRUSTED_ORIGINS=https://study.example.com
EI_HOSTS=ei.example.com
EI_ORIGIN=https://ei.example.com
TRACKER_DAILY_TARGET_MINUTES=360
TRACKER_WEEKLY_TARGET_MINUTES=2520
TRACKER_EXAM_DATE=2026-12-26
TRACKER_HEATMAP_START_DATE=2026-05-23
# Optional dashboard copy. Leave blank to preserve the original homepage.
TRACKER_HOMEPAGE_CONTENT=
TRACKER_COUNTDOWN_LABEL=2026 Postgraduate Exam
# Authenticated dashboard only; keep the real value in the untracked .env file.
STUDY_ROOM_CODE=
# Optional. Docker images already use /app/data/tracker.env automatically.
# TRACKER_LOCAL_ENV_PATH=/absolute/path/to/.env
# Optional encrypted-storage key controls. Normally Django creates a mode-600
# key file beside TRACKER_LOCAL_ENV_PATH on first use. Multi-host deployments
# should inject the same URL-safe base64 32-byte key through a secret manager.
# DATA_ENCRYPTION_KEY_PATH=/absolute/path/to/.data-encryption.key
# DATA_ENCRYPTION_MASTER_KEY=
MCP_HOST=127.0.0.1
MCP_PORT=8001
# Public deployments should use a random 32+ character URL key.
MCP_URL_KEY=
# Only enable this for a loopback server reached through a trusted private tunnel.
MCP_ALLOW_UNAUTHENTICATED=false
# Optional: archive every newly completed task through the authenticated gh CLI.
LEARNING_REPO=
LEARNING_REPO_PATH=../personal-learning-notes
# Administrators sync here; other users sync to a sanitized username branch.
LEARNING_REPO_MAIN_BRANCH=main
# Public contact form. Gmail requires an app-specific password, not the normal password.
CONTACT_EMAIL=zsyeh7286@gmail.com
CONTACT_RATE_LIMIT_PER_HOUR=3
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10
DEFAULT_FROM_EMAIL=zsyeh7286@gmail.com
# Optional bounded remote stress probe. Generate a random 32+ character key,
# keep it out of URLs, and send it as Authorization: Bearer <key>.
STRESS_TEST_ENABLED=false
STRESS_TEST_KEY=
# Per Gunicorn worker. Keep this conservative; higher ramps require an explicit
# server-side change and remain subject to PC safety guards.
STRESS_TEST_MAX_RPS=20
STRESS_TEST_MAX_BODY_BYTES=4096
# Required only to create/prepare real authenticated isolated workloads.
# Exact-prefix recovery cleanup remains available after this is disabled.
STRESS_TEST_ALLOW_DATA_SETUP=false
STRESS_TEST_MAX_USERS=60
STRESS_TEST_MAX_HISTORY_ROWS=20000
STRESS_TEST_RUN_TTL_SECONDS=7200
# Optional when a virtual NIC cannot report the provider bandwidth contract.
STRESS_TEST_NETWORK_INTERFACE=
STRESS_TEST_NETWORK_CAPACITY_MBPS=0
STRESS_TEST_GUNICORN_PORT=8000
# Optional controlled cache experiment. Default remains file.
# file (default), dummy (no-cache experiment), locmem, or redis.
DJANGO_CACHE_BACKEND=file
# REDIS_CACHE_URL=redis://127.0.0.1:6379/1
# Optional PostgreSQL connection for new deployments.
# DATABASE_URL=postgresql://tracker:password@db:5432/tracker
POSTGRES_DB=learning_os
POSTGRES_USER=learning_os
POSTGRES_PASSWORD=
